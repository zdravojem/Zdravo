# Dependencies
node_modules/

# Generated browser configuration.
# Holds the Supabase URL and anon key and is written by `npm run env:build` —
# on Netlify from the site's environment variables, locally from .env.local.
# Never commit it: the values differ per environment.
public/env.js

# Deploy tooling
.netlify/
dist/
out/
release/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment and local config
.env
.env.*
!.env.example

# Secrets / credentials (never commit)
credentials.json
token.json
supabase-config.json
*.pem
*.key

# Supabase CLI local state
supabase/.temp/
supabase/.branches/

# OS and editor files
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.swp
*.swo

# Test and coverage output
coverage/
.nyc_output/

# Cache directories
.cache/
.parcel-cache/
.eslintcache

# Scratch/debug files (not part of the app)
_tmp_*
