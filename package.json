{
  "name": "zdravo-jem",
  "version": "2.0.0",
  "description": "Zdravo Jem kiosk — installable PWA",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "start": "node scripts/serve.cjs",
    "build": "npm run assets:manifest && npm run env:build",
    "env:build": "node scripts/build-env.cjs",
    "assets:manifest": "node scripts/build-asset-manifest.cjs",
    "icons:build": "node scripts/build-icons.cjs",
    "images:optimize": "node scripts/optimize-images.cjs",
    "vendor:qrcode": "node scripts/vendor-qrcode.cjs",
    "recipe-share:build": "node scripts/build-recipe-share.cjs",
    "recipe-qr:sync": "node scripts/sync-recipe-qr-pages.cjs",
    "recipe-qr:dry-run": "node scripts/sync-recipe-qr-pages.cjs --dry-run",
    "docs:pdf": "node scripts/build-docs-pdf.cjs"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1067.0",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.2",
    "googleapis": "^173.0.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.3"
  }
}
